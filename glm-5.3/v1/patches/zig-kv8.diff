new file mode 100644
index 00000000..d7534f73
--- /dev/null
+++ b/zig/tests/cuda/kv8repro.zig
@@ -0,0 +1,227 @@
+//! kv8repro: TF_GLM53_KV8's write/read chain against the bf16 path it wraps, self-consistent, no model needed.
+//! Usage: kv8repro <aot dir> [--pos N] [--rows R]
+//!
+//! The parallel-8 serve exercises the ROWS (base-table) kv8 path every decode window - that path is proven
+//! healthy on the live boot. The PROMPT path (a stream's slot view, base 0) is the only place the NON-ROWS
+//! chain runs: kv8_stage(ROWS_MODE=0) -> _kv_write ROWS with (P', B') -> kv8_quant(rows_mode=0) ->
+//! kv8_dequant(mode 1) -> _attn_chunks over the block scratch. This reproduces that chain with synthetic rows
+//! and gates it against the bf16 semantics:
+//!   1. the staged rows must be BIT-IDENTICAL to what the bf16 non-ROWS _kv_write puts in a real cache at the
+//!      same positions (the whole point of the staging tables - the rope at the TRUE position);
+//!   2. the stage tables must be P'[r] = pos + r, B'[r] = r - P'[r];
+//!   3. dequant(quant(staging)) must round-trip within e4m3 (and the scratch rows must equal the plane's
+//!      dequantized rows exactly - the mode-1 direct region the p < K attention reads).
+//! Prints PASS/FAIL per gate; exit 0 only on PASS.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm53");
+
+const usage = "usage: kv8repro <aot dir> [--pos N] [--rows R]\n";
+
+const lw = 512;
+const rd = 64;
+const w576 = lw + rd;
+const k_sel = 2048;
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 2) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    var pos: usize = 0;
+    var rows: usize = 24;
+    var i: usize = 2;
+    while (i < args.len) : (i += 1) {
+        if (std.mem.eql(u8, args[i], "--pos") and i + 1 < args.len) {
+            pos = try std.fmt.parseInt(usize, args[i + 1], 10);
+            i += 1;
+        } else if (std.mem.eql(u8, args[i], "--rows") and i + 1 < args.len) {
+            rows = try std.fmt.parseInt(usize, args[i + 1], 10);
+            i += 1;
+        } else {
+            std.debug.print("{s}", .{usage});
+            return 2;
+        }
+    }
+    const ok = run(init.gpa, init.io, args[1], pos, rows) catch |e| {
+        std.debug.print("RESULT kv8repro FAIL error {t}\n", .{e});
+        return 1;
+    };
+    return if (ok) 0 else 1;
+}
+
+fn run(gpa: std.mem.Allocator, io: std.Io, aot: []const u8, pos: usize, R: usize) !bool {
+    if (R == 0 or pos + R > 100_000) return error.Invalid;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var k = try glm.kernels.Kernels.load(gpa, io, &ctx, aot);
+    defer k.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    const o = glm.kernels.Ops{ .k = &k, .s = stream };
+    const t = glm.triton.Tri{ .set = &k.triton, .s = stream };
+    const m: glm.triton.Mla = .{ .heads = 8, .nope = 192, .rope = rd, .lw = lw, .vd = 256, .topk = k_sel };
+
+    // synthetic inputs: kva rows [R, 576] bf16, kv_a_norm [512], inv_freq [32], the position word
+    const host_kva = try gpa.alloc(u16, R * w576);
+    defer gpa.free(host_kva);
+    for (host_kva, 0..) |*x, i| {
+        const r = i / w576;
+        const c = @mod(i, w576);
+        const v: f32 = @sin(@as(f32, @floatFromInt(r)) * 0.37 + @as(f32, @floatFromInt(c)) * 0.011) * 3.0 + 0.1;
+        x.* = @bitCast(glm.weights.bf16Bits(v));
+    }
+    const host_nw = try gpa.alloc(u16, lw);
+    defer gpa.free(host_nw);
+    for (host_nw, 0..) |*x, j| x.* = @bitCast(glm.weights.bf16Bits(1.0 + 0.001 * @as(f32, @floatFromInt(j))));
+    var host_inv: [rd / 2]f32 = undefined;
+    for (&host_inv, 0..) |*x, j| x.* = @floatCast(std.math.pow(f64, 10000.0, -2.0 * @as(f64, @floatFromInt(j)) / rd));
+
+    var d_kva = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(host_kva));
+    defer d_kva.free();
+    var d_nw = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(host_nw));
+    defer d_nw.free();
+    var d_inv = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(host_inv[0..]));
+    defer d_inv.free();
+    var d_pos = try cuda.DeviceBuffer.alloc(&driver, 4);
+    defer d_pos.free();
+    {
+        const p: i32 = @intCast(pos);
+        try d_pos.upload(0, std.mem.asBytes(&p));
+    }
+    var d_zero = try cuda.DeviceBuffer.alloc(&driver, 4 * 256);
+    defer d_zero.free();
+    try d_zero.fill8(0, null);
+
+    const cache_rows = pos + R;
+    // the bf16 reference cache: _kv_write NON-ROWS at the true position (the path the bf16 serve runs)
+    var d_ref = try cuda.DeviceBuffer.alloc(&driver, cache_rows * w576 * 2);
+    defer d_ref.free();
+    try d_ref.fill8(0, null);
+    // the kv8 side: staging, the plane (584-B rows), the block scratch, the stage tables
+    var d_stage = try cuda.DeviceBuffer.alloc(&driver, R * w576 * 2);
+    defer d_stage.free();
+    var d_plane = try cuda.DeviceBuffer.alloc(&driver, cache_rows * (w576 + 8));
+    defer d_plane.free();
+    try d_plane.fill8(0, null);
+    var d_scratch = try cuda.DeviceBuffer.alloc(&driver, R * k_sel * w576 * 2);
+    defer d_scratch.free();
+    var d_spos = try cuda.DeviceBuffer.alloc(&driver, 256 * 4);
+    defer d_spos.free();
+    var d_sbase = try cuda.DeviceBuffer.alloc(&driver, 256 * 4);
+    defer d_sbase.free();
+
+    // ---- the bf16 reference write: non-ROWS, the real cache, POS = the position word
+    try t.kvWriteDcp(d_kva.ptr, w576, d_nw.ptr, d_ref.ptr, d_pos.ptr, d_inv.ptr, 1e-5, R, m, 1, 0);
+
+    // ---- the kv8 staged write: the tables, then _kv_write ROWS into the staging buffer
+    try o.kv8Stage(d_spos.ptr, d_sbase.ptr, d_pos.ptr, R, false);
+    try t.kvWriteRowsDcp(d_kva.ptr, w576, d_nw.ptr, d_stage.ptr, d_spos.ptr, d_sbase.ptr, d_inv.ptr, 1e-5, R, m, 1, 0);
+    try o.kv8Quant(d_stage.ptr, d_plane.ptr, d_pos.ptr, 0, R, false, lw, w576);
+
+    // ---- the read: mode 1 (the prompt window's shape: p = pos + r, the direct region while p < K)
+    try o.kv8Dequant(d_plane.ptr, d_scratch.ptr, d_pos.ptr, d_zero.ptr, d_zero.ptr, R, k_sel, lw, w576, 1, 0);
+    try stream.synchronize();
+
+    // ---- gate 1: the stage tables
+    var ok = true;
+    {
+        const spos = try gpa.alloc(i32, 256);
+        defer gpa.free(spos);
+        const sbase = try gpa.alloc(i32, 256);
+        defer gpa.free(sbase);
+        try d_spos.download(0, std.mem.sliceAsBytes(spos));
+        try d_sbase.download(0, std.mem.sliceAsBytes(sbase));
+        var bad: usize = 0;
+        for (0..R) |r| {
+            if (spos[r] != @as(i32, @intCast(pos + r))) bad += 1;
+            if (sbase[r] != @as(i32, @intCast(r)) - spos[r]) bad += 1;
+        }
+        if (bad == 0) {
+            std.debug.print("PASS stage tables: P'[r] = pos + r, B'[r] = r - P'\n", .{});
+        } else {
+            ok = false;
+            std.debug.print("FAIL stage tables: {d} wrong entries (P'[0]={d} B'[0]={d}, pos={d})\n", .{ bad, spos[0], sbase[0], pos });
+        }
+    }
+
+    // ---- gate 2: the staged rows bit-identical to the bf16 cache's rows at the same positions
+    {
+        const stage = try gpa.alloc(u8, R * w576 * 2);
+        defer gpa.free(stage);
+        const ref = try gpa.alloc(u8, cache_rows * w576 * 2);
+        defer gpa.free(ref);
+        try d_stage.download(0, stage);
+        try d_ref.download(0, ref);
+        var bad: usize = 0;
+        var first: usize = 0;
+        for (0..R) |r| {
+            const a = stage[r * w576 * 2 ..][0 .. w576 * 2];
+            const b = ref[(pos + r) * w576 * 2 ..][0 .. w576 * 2];
+            if (!std.mem.eql(u8, a, b)) {
+                bad += 1;
+                if (bad == 1) first = r;
+            }
+        }
+        if (bad == 0) {
+            std.debug.print("PASS staged rows: bit-identical to the bf16 cache rows (rope at the true position)\n", .{});
+        } else {
+            ok = false;
+            var ca: u16 = 0;
+            var cb: u16 = 0;
+            {
+                const a = stage[first * w576 * 2 ..][0 .. w576 * 2];
+                const b = ref[(pos + first) * w576 * 2 ..][0 .. w576 * 2];
+                ca = std.mem.bytesAsSlice(u16, a)[0];
+                cb = std.mem.bytesAsSlice(u16, b)[0];
+            }
+            std.debug.print("FAIL staged rows: {d} of {d} differ (first row {d}: staging {x} vs bf16 {x})\n", .{ bad, R, first, ca, cb });
+        }
+    }
+
+    // ---- gate 3: the roundtrip - the mode-1 scratch's direct region vs the bf16 reference, within e4m3
+    {
+        const scratch = try gpa.alloc(u8, R * k_sel * w576 * 2);
+        defer gpa.free(scratch);
+        const ref = try gpa.alloc(u8, cache_rows * w576 * 2);
+        defer gpa.free(ref);
+        try d_scratch.download(0, scratch);
+        try d_ref.download(0, ref);
+        var worst: f32 = 0;
+        var bad: usize = 0;
+        var first: usize = 0;
+        // the p < K direct region: scratch row i holds plane row i; every row r reads keys 0..pos + r
+        for (0..R) |r| {
+            const p = pos + r;
+            if (p >= k_sel) break; // past K the block region takes over; the live short-prompt case is all-direct
+            for (0..p + 1) |i| {
+                const a = std.mem.bytesAsSlice(u16, scratch[i * w576 * 2 ..][0 .. w576 * 2]);
+                const b = std.mem.bytesAsSlice(u16, ref[i * w576 * 2 ..][0 .. w576 * 2]);
+                for (0..w576) |c| {
+                    const va: f32 = @bitCast(@as(u32, a[c]) << 16);
+                    const vb: f32 = @bitCast(@as(u32, b[c]) << 16);
+                    const denom = @max(@abs(vb), 1e-3);
+                    const rel = @abs(va - vb) / denom;
+                    if (rel > worst) worst = rel;
+                    if (rel > 0.20) { // e4m3 with per-row scales: ~6% typical, subnormal tails wider
+                        bad += 1;
+                        if (bad == 1) first = i * w576 + c;
+                    }
+                }
+            }
+        }
+        if (bad == 0) {
+            std.debug.print("PASS roundtrip: the scratch's direct region matches the bf16 rows (worst rel {d:.4})\n", .{worst});
+        } else {
+            ok = false;
+            std.debug.print("FAIL roundtrip: {d} values past 20% rel (worst {d:.4}, first at flat {d})\n", .{ bad, worst, first });
+        }
+    }
+
+    std.debug.print("RESULT kv8repro {s} pos={d} rows={d}\n", .{ if (ok) "PASS" else "FAIL", pos, R });
+    return ok;
+}
