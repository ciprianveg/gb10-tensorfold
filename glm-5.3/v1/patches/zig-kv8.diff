+test "TF_GLM53_KV8's cache bytes: e4m3 latent + 2 fp32 scales a row, index keys bf16 (findings-kv8.md §2.1)" {
+    // the latent row: 576 e4m3 codes + two fp32 scales = 584 bytes (bf16: 1152); tokenBytes takes the row's
+    // elements (it doubles them), so kv8's 584-byte row is 292 "elements"
+    const tb8 = tokenBytes(78, 21, 292, 128, true, true);
+    try std.testing.expectEqual(@as(usize, 51_768), tb8); // 79 x 584 + 22 x 256
+    const tb16 = tokenBytes(78, 21, 576, 128, true, true);
+    // 50.6 KiB a token: 53.55% of bf16's 94.4 - the DCP 1 ceiling roughly x1.87
+    try std.testing.expectApproxEqAbs(@as(f64, 50.55), @as(f64, @floatFromInt(tb8)) / 1024.0, 0.01);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5355), @as(f64, @floatFromInt(tb8)) / @as(f64, @floatFromInt(tb16)), 0.001);
+    // the 32K x 8 serve's 2.95 GiB a stream drops to ~1.59
+    const gib: f64 = 1 << 30;
+    try std.testing.expectApproxEqAbs(@as(f64, 2.95), @as(f64, @floatFromInt(rankCacheBytes(tb16, 32_768, 2, 1, 1))) / gib, 0.01);
+    try std.testing.expectApproxEqAbs(@as(f64, 1.58), @as(f64, @floatFromInt(rankCacheBytes(tb8, 32_768, 2, 1, 1))) / gib, 0.01);
+}
